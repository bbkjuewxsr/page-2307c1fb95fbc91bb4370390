          "body": "<style>\n  :root{--deep:#0d2a44;--deep-2:#123a5c;--deep-3:#081d30;--amber:#e8a33d;--amber-soft:#f6d9a8;--ink:#13202c;--paper:#f6f4ef;--paper-2:#ffffff;--muted:#5c6b7a;--line:rgba(13,42,68,.12)}\n  *{box-sizing:border-box}\n  html,body{margin:0;padding:0}\n  body{background:var(--paper);color:var(--ink);font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,-apple-system,\"Segoe UI\",sans-serif;font-size:16px;line-height:1.75;-webkit-font-smoothing:antialiased}\n  a{color:inherit}\n  .wrap{max-width:1080px;margin:0 auto;padding:0 22px}\n\n  /* ===== HERO ===== */\n  .hero{background:var(--deep);color:#eef3f8;padding:0 0 56px;position:relative}\n  .hero-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:48px;align-items:start;padding-top:46px}\n  .eyebrow{display:inline-block;font-size:12px;letter-spacing:.22em;color:var(--amber);border:1px solid rgba(232,163,61,.5);border-radius:999px;padding:4px 14px;margin-bottom:26px}\n  h1{font-size:clamp(34px,5vw,58px);line-height:1.18;letter-spacing:-.5px;margin:0 0 22px;font-weight:800}\n  h1 .thin{display:block;font-weight:400;font-size:.46em;letter-spacing:.02em;color:#a9c2d6;margin-top:10px;line-height:1.5}\n  .hero-copy p{margin:0 0 16px;color:#cddcea;font-size:16.5px;max-width:56ch}\n  .hero-copy p.lead{color:#f0f5fa;font-size:18px}\n  .anchors{margin-top:34px;padding-top:22px;border-top:1px solid rgba(255,255,255,.14);display:flex;flex-wrap:wrap;gap:10px}\n  .anchors a{text-decoration:none;font-size:14px;color:#e6eef6;border:1px solid rgba(255,255,255,.22);border-radius:8px;padding:7px 14px;transition:background .15s ease,border-color .15s ease}\n  .anchors a:hover{background:rgba(232,163,61,.18);border-color:var(--amber)}\n  .anchors a .num{color:var(--amber);margin-right:7px;font-size:12px}\n\n  .side-panel{background:var(--deep-2);border-radius:20px;padding:26px 24px;box-shadow:0 22px 44px -26px rgba(0,0,0,.7)}\n  .side-panel h2{font-size:13px;letter-s
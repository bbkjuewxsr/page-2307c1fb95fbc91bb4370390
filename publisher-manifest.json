letter-spacing:.22em;color:#b87b24;margin:0 0 18px;font-weight:700}\n  .qa{border-top:1px solid var(--line);padding:18px 0}\n  .qa:first-of-type{border-top:0}\n  .qa h4{margin:0 0 8px;font-size:16px;font-weight:700;color:var(--deep);line-height:1.55}\n  .qa p{margin:0;font-size:14.8px;color:#42566a}\n\n  /* closing */\n  .closing{background:var(--deep);color:#eef3f8;border-radius:24px;padding:44px 38px;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:32px;align-items:center}\n  .closing h2{color:#fff;margin-bottom:10px}\n  .closing p{margin:0;color:#b9cddd;font-size:15px;max-width:52ch}\n  .closing .links{display:flex;flex-wrap:wrap;gap:10px}\n  .closing .links a{text-decoration:none;font-size:14px;color:var(--deep-3);background:var(--amber);border-radius:9px;padding:9px 16px;font-weight:700}\n  .closing .links a.ghost{background:transparent;color:#e6eef6;border:1px solid rgba(255,255,255,.3);font-weight:500}\n\n  footer{padding:38px 0 54px;color:var(--muted);font-size:13px}\n  footer .wrap{display:flex;flex-wrap:wrap;gap:12px 28px;justify-content:space-between;border-top:1px solid var(--line);padding-top:22px}\n\n  @media(max-width:900px){\n    .hero-grid{grid-template-columns:1fr;gap:32px}\n    .usage{grid-template-columns:repeat(2,minmax(0,1fr))}\n    .clients{grid-template-columns:1fr}\n    .plan{grid-template-columns:1fr;gap:16px}\n    .closing{grid-template-columns:1fr;padding:34px 26px}\n  }\n  @media(max-width:560px){\n    .usage{grid-template-columns:1fr}\n    section{padding:56px 0}\n    .plans{padding:56px 0}\n    .plan{padding:24px 20px}\n    .faq-group{padding:24px 20px 6px}\n    .hero{padding-bottom:44px}\n  }\n</style><header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-grid\">\n      <div class=\"hero-copy\">\n        <span class=\"eyebrow\">幻影 · 订阅说明</span>\n        <h1>幻影，把订阅这件事说清楚\n          <span class=\"thin\">三档方案。写清流量、设备数、线路与支持方式。读完再决定，不急着下单。</span>\n        </h1>\n        <p class=\"lead\">大多数订阅页面喜欢先讲情怀。我们把顺序反过来：先给你数字，再给你步骤，最后才是那些容易被含糊带过的细节。</p>\n        <p>幻影提供按月或按年计费的订阅方案。计费周期、可同时在线设备数、每月流量额度，都写在方案卡里，不做隐藏。你可以在下面看到完整的三档对比，以及使用前需要准备的东西。</p>\n        <p>如果读完仍有疑问，常见问题按主题分了组——账务、设备、流量、支持。没有答案的那部分，我们不会编一个。</p>\n        <nav class=\"anchors\" aria-label=\"页面内锚点\">\n          <a href=\"#usage\"><span class=\"num\">01</span>怎么开始</a>\n          <a href=\"#plans\"><span class=\"num\">02</span>方案与价格</a>\n          <a href=\"#clients\"><span class=\"num\">03</span>客户端说明</a>\n          <a href=\"#faq\"><span class=\"num\">04</span>常见问题</a>\n        </nav>\n      </div>\n\n      <aside class=\"side-panel\" aria-label=\"方案速览\">\n        <h2>速览</h2>\n        <ul class=\"side-list\">\n          <li><span>方案档位</span><b>3 档</b></li>\n          <li><span>起步价</span><b>¥15 / 月</b></li>\n          <li><span>年付起步</span><b>¥150 / 年</b></li>\n          <li><span>流量区间</span><b>100GB – 1000GB / 月</b></li>\n          <li><span>设备上限</span><b>3 – 20 台</b></li>\n          <li><span>计费周期</span><b>月付 / 年付</b></li>\n        </ul>\n        <p class=\"side-note\">速览只做索引。具体权益以方案区列出的条目为准，两处内容一致。</p>\n      </aside>\n    </div>\n  </div>\n</header>\n<div class=\"ribbon\"></div>\n\n<main>\n\n  <section id=\"usage\">\n    <div class=\"wrap\">\n      <p class=\"kicker\">使用说明</p>\n      <h2>四步走完，不用记太多</h2>\n      <p class=\"sec-intro\">流程本身不复杂。把顺序做对，后面就少回头。</p>\n      <div class=\"usage\">\n        <article class=\"step\">\n          <span class=\"n\">STEP 01</span>\n          <h3>挑一档方案</h3>\n          <p>先看设备数和每月流量，再看价格。一个人的手机加一台电脑，和二十台设备的团队，需要的不是同一档。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"n\">STEP 02</span>\n          <h3>决定月付或年付</h3>\n          <p>月付按自然月计费，年付一次性付清全年。年付单价更低，但需要你确认会用满一年。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"n\">STEP 03</span>\n          <h3>在你自己的设备上配置</h3>\n          <p>按客户端说明操作。幻影不代为安装设备，也不要求你交出设备控制权。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"n\">STEP 04</span>\n          <h3>留意流量与设备数</h3>\n          <p>每月额度在计费周期开始时重置。同时在线设备超过上限时，最早连接的一台会被挤出。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\" class=\"plans\">\n    <div class=\"wrap\">\n      <p class=\"kicker\">方案</p>\n      <h2>三档，逐年加一档的量</h2>\n      <p class=\"sec-intro\">价格与权益逐档递进。年付价格写在每档下方，没有额外折扣需要你再问一次。</p>\n\n      <div class=\"plan-stack\">\n        <article class=\"plan plan-1\">\n          <div>\n            <p class=\"tier\">TIER 01</p>\n            <h3>基础版</h3>\n            <p class=\"price\">¥15 <span>/ 月</span></p>\n            <p class=\"annual\">按年付 ¥150 / 年</p>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 100GB 流量额度</li>\n            <li>最多 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan plan-2\">\n          <div>\n            <p class=\"tier\">TIER 02</p>\n            <h3>旗舰版</h3>\n            <p class=\"price\">¥35 <span>/ 月</span></p>\n            <p class=\"annual\">按年付 ¥350 / 年</p>\n            <span class=\"tag\">多数人停在这一档</span>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 300GB 流量额度</li>\n            <li>最多 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan plan-3\">\n          <div>\n            <p class=\"tier\">TIER 03</p>\n            <h3>团队版</h3>\n            <p class=\"price\">¥85 <span>/ 月</span></p>\n            <p class=\"annual\">按年付 ¥850 / 年</p>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 1000GB 流量额度</li>\n            <li>最多 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理对接</li>\n          </ul>\n        </article>\n      </div>\n\n      <p class=\"plan-foot\">价格与权益如上，不会在结算页另行追加。实际可用性取决于你所处网络环境与设备配置，页面不对速度、延迟或节点数量作任何承诺。购买入口尚未在本文档中给出，请通过官方渠道确认后再付款。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <p class=\"kicker\">客户端</p>\n      <h2>用什么设备，决定你配哪个客户端</h2>\n      <p class=\"sec-intro\">下面三类是常见的使用场景。幻影不代为分发安装包，也不提供非官方来源的下载地址；请以你所用平台的正规渠道为准。</p>\n      <div class=\"clients\">\n        <article class=\"client\">\n          <p class=\"meta\">桌面端</p>\n          <h3>电脑上使用</h3>\n          <p>适合长时间在线、需要多窗口并行的场景。旗舰版及以上可覆盖一到两台电脑加移动设备的组合。</p>\n          <span class=\"status\">安装包请从官方渠道获取</span>\n        </article>\n        <article class=\"client\">\n          <p class=\"meta\">移动端</p>\n          <h3>手机上使用</h3>\n          <p>通勤、外出时的主要选择。注意把同时在线设备数算进方案上限，别让手机占掉工作设备的名额。</p>\n          <span class=\"status\">安装包请从官方渠道获取</span>\n        </article>\n        <article class=\"client\">\n          <p class=\"meta\">路由与多设备</p>\n          <h3>整屋或多终端</h3>\n          <p>设备多的场景更适合团队版。定制路由需要与客户经理确认具体配置，不默认包含在所有方案内。</p>\n          <span class=\"status\">定制项需单独确认</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <p class=\"kicker\">常见问题</p>\n      <h2>按主题分组，找起来快一点</h2>\n      <p class=\"sec-intro\">四组问题，覆盖账务、设备、流量与支持。答案只写确定的内容。</p>\n\n      <div class=\"faq-groups\">\n\n        <div class=\"faq-group\">\n          <h3>账务与计费</h3>\n          <div class=\"qa\">\n            <h4>月付和年付有什么区别？</h4>\n            <p>计费周期不同。月付每自然月结算一次，年付一次性支付全年费用。以基础版为例，月付为 ¥15 / 月，年付为 ¥150 / 年。年付需要你确认会使用满一年。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>中途可以换档吗？</h4>\n            <p>换档涉及费用差额与周期重算，具体处理方式请以官方渠道的说明为准。本文档不对换档规则作额外承诺，也不描述未确认的退款政策。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>价格以后会变吗？</h4>\n            <p>页面所列价格是当前展示的档位价格。若后续调整，以你实际下单时看到的金额为准，本文档不构成长期价格承诺。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>设备与同时在线</h3>\n          <div class=\"qa\">\n            <h4>“同时在线”怎么算？</h4>\n            <p>指同一时刻保持连接的设备数量。基础版 3 台、旗舰版 5 台、团队版 20 台。超出上限时，先连接的设备会断开，需要你手动调整。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>一台设备装了多个客户端，算几台？</h4>\n            <p>按设备本身计数，不按客户端数量计数。同一台设备上切换客户端，不额外占用名额。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>团队版的定制路由是自动开通的吗？</h4>\n            <p>不是。定制路由需要与专属客户经理确认具体需求后再配置，并非下单即生效的默认项。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>流量额度</h3>\n          <div class=\"qa\">\n            <h4>每月流量什么时候重置？</h4>\n            <p>在每个计费周期开始时重置。月付按月重置，年付按年付周期内的月度节奏处理，具体以官方账单页显示为准。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>没用完的流量能留到下个月吗？</h4>\n            <p>不能结转。额度属于当期，周期结束后清零，不累积。如果你长期用不满，可以考虑降到更低一档。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>用超了会怎样？</h4>\n            <p>额度用尽后当期服务受限，需要等到下一个计费周期或调整档位。本文档不描述超出后的具体处置细节，请以官方说明为准。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>支持与排障</h3>\n          <div class=\"qa\">\n            <h4>哪个档位有优先支持？</h4>\n            <p>旗舰版包含 7×24 优先工单支持，团队版由专属客户经理对接。基础版为标准支持通道，响应节奏与优先通道不同。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>连接不顺畅时先查什么？</h4>\n            <p>先确认设备数是否超限、当期流量是否用尽，再检查客户端版本与本地网络。这三项排掉之后仍不正常，再走工单，能省一轮来回。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>你们会记录我的使用内容吗？</h4>\n            <p>本文档不对日志策略作任何未经确认的表述。若这一点对你的选择很关键，请在下单前通过官方渠道直接确认。</p>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"wrap\">\n      <div class=\"closing\">\n        <div>\n          <h2>看到这里，基本可以决定了</h2>\n          <p>一个人用，基础版够；手机加电脑再加平板，旗舰版更稳；设备多、要定制，才轮到团队版。拿不准就先月付。</p>\n        </div>\n        <div class=\"links\">\n          <a href=\"#plans\">回看方案</a>\n          <a href=\"#usage\" class=\"ghost\">再看使用步骤</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <span>幻影 · 订阅说明页面</span>\n    <span>价格与权益以本页方案区为准，正文与方案区表述一致。</span>\n  </div>\n</footer>",
